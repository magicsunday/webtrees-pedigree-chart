declare(strict_types=1);

/**
 * Stand-in for the inline radio buttons of the webtrees core. It renders one label per option, in
 * the order of the options, and keeps the value and the checked state of each radio button.
 *
 * @var string                $name
 * @var array<string, string> $options
 * @var string                $selected
 */
?>
<?php foreach ($options as $value => $label) { ?>
    <label class="radio"><input type="radio" name="<?php echo e($name); ?>" value="<?php echo e((string) $value); ?>"<?php echo ((string) $value === $selected) ? ' checked' : ''; ?>><?php echo $label; ?></label>
<?php } ?>
